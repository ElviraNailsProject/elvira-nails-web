{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "elvira-nails-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit",
    "prepare": "husky",
    "db:seed": "tsx scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "cms": "node scripts/payload.mjs",
    "cms:types": "node scripts/payload.mjs generate:types",
    "cms:importmap": "node scripts/payload.mjs generate:importmap",
    "cms:migrate": "node scripts/payload.mjs migrate",
    "cms:admin": "tsx scripts/cms-admin.ts",
    "test": "tsx --test tests/*.test.ts src/features/student-cases/public/*.test.ts",
    "test:integration": "node scripts/test-cms.mjs",
    "check": "npm run test && npm run types && npm run lint && npm run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "drizzle-orm": "0.45.2",
    "graphql": "16.11.0",
    "next": "16.3.6",
    "payload": "3.91.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
