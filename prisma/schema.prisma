generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceType {
  MAIN
  ADD_ON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InquiryTopic {
  TRAINING
  STUDIO_APPOINTMENT
  SOMETHING_ELSE
}

enum TrainingApplicationStatus {
  NEW
  IN_PROGRESS
  DATE_AGREED
  PAID
  CANCELLED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum Locale {
  NL
  EN
  RU
  UK
}

enum StudentContactType {
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  TIKTOK
  EMAIL
  WEBSITE
}

enum OfferTargetType {
  TRAINING
  STUDIO_SERVICE
}

model Service {
  id          String      @id @default(cuid())
  price       Decimal     @db.Decimal(10, 2)
  duration    Int
  type        ServiceType @default(MAIN)
  photoUrl    String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)

  translations ServiceTranslation[]
  appointments AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model ServiceTranslation {
  id        String @id @default(cuid())
  serviceId String
  locale    Locale

  name        String
  description String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([locale])
}

model Appointment {
  id                  String            @id @default(cuid())
  fullName            String
  email               String
  phone               String
  notes               String?
  appointmentDate     DateTime
  status              AppointmentStatus @default(PENDING)
  privacyConsent      Boolean
  cancellationConsent Boolean
  cancelledAt         DateTime?
  cancellationReason  String?

  services AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentDate])
  @@index([status])
}

model AppointmentService {
  id            String  @id @default(cuid())
  appointmentId String
  serviceId     String

  serviceName String
  price       Decimal @db.Decimal(10, 2)
  duration    Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
}

model WorkingHours {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime Int
  endTime   Int
  isActive  Boolean @default(true)

  @@unique([dayOfWeek])
}

model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime @db.Date
  reason String?

  @@unique([date])
}

model TrainingApplication {
  id       String @id @default(cuid())
  fullName String
  email    String
  phone    String
  message  String?

  privacyConsent Boolean
  status         TrainingApplicationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id       String       @id @default(cuid())
  fullName String
  email    String
  phone    String
  topic    InquiryTopic
  message  String

  privacyConsent Boolean
  status         ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
  @@index([status])
  @@index([createdAt])
}

model TrainingProgram {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  translations TrainingProgramTranslation[]
  stages       TrainingStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingProgramTranslation {
  id        String @id @default(cuid())
  programId String
  locale    Locale

  title       String
  description String?

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, locale])
  @@index([locale])
}

model TrainingStage {
  id        String @id @default(cuid())
  programId String
  sortOrder Int    @default(0)

  program      TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  translations TrainingStageTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model TrainingStageTranslation {
  id      String @id @default(cuid())
  stageId String
  locale  Locale

  title       String
  description String?
  duration    String?

  stage TrainingStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, locale])
  @@index([locale])
}

model FAQ {
  id        String  @id @default(cuid())
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  translations FAQTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQTranslation {
  id     String @id @default(cuid())
  faqId  String
  locale Locale

  question String
  answer   String

  faq FAQ @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
  @@index([locale])
}

model StudentCase {
  id           String   @id @default(cuid())
  studentName  String
  initials     String?
  studentPhoto String?
  caseDate     DateTime? @db.Date
  city         String?
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)

  images       StudentCaseImage[]
  contacts     StudentCaseContact[]
  translations StudentCaseTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([caseDate])
}

model StudentCaseTranslation {
  id      String @id @default(cuid())
  caseId  String
  locale  Locale

  resultTitle String?
  story       String?
  testimonial String?
  status      String?

  studentCase StudentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, locale])
  @@index([locale])
}

model StudentCaseImage {
  id        String  @id @default(cuid())
  caseId    String
  url       String
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  studentCase StudentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model StudentCaseContact {
  id        String             @id @default(cuid())
  caseId    String
  type      StudentContactType
  value     String
  sortOrder Int                @default(0)

  studentCase StudentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, type])
  @@index([caseId])
}

model Offer {
  id          String          @id @default(cuid())
  imageUrl    String
  targetType  OfferTargetType
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)

  translations OfferTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([validUntil])
}

model OfferTranslation {
  id      String @id @default(cuid())
  offerId String
  locale  Locale

  title       String?
  description String?
  altText     String

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, locale])
  @@index([locale])
}

model SiteSettings {
  id String @id @default("singleton")

  email     String?
  phone     String?
  whatsapp  String?
  address   String?
  instagram String?
  telegram  String?
  tiktok    String?
  website   String?
  kvkNumber String?
  vatNumber String?

  timeZone           String @default("Europe/Amsterdam")
  bookingHorizonDays Int    @default(21)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}