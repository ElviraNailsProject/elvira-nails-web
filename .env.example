# Reference only. Preserve an existing .env; put new CMS settings in .env.local.
# Never point tests or local development at production data.

# Existing Prisma application. Prisma CLI loads .env, not the CMS wrapper.
# These values match the local postgres service in compose.yaml.
DATABASE_URL="postgresql://elvira_dev:local_dev_only@127.0.0.1:54322/elvira_dev"
DIRECT_URL="postgresql://elvira_dev:local_dev_only@127.0.0.1:54322/elvira_dev"

# Payload owns a DIFFERENT database. Never reuse the Prisma database here.
CMS_DATABASE_URL="postgresql://elvira_cms_dev:local_cms_dev_only@127.0.0.1:54323/elvira_cms_dev"
# Generate a unique random secret, at least 32 characters. See docs/payload-cms.md.
PAYLOAD_SECRET=""
# Must exactly match the browser origin, including port.
APP_ORIGIN="http://localhost:3000"

# local: development uploads under .local/cms-media (not for serverless).
# s3: private S3-compatible bucket, served through Payload access control.
CMS_STORAGE="local"
CMS_S3_BUCKET=""
CMS_S3_REGION=""
CMS_S3_ENDPOINT=""
CMS_S3_ACCESS_KEY_ID=""
CMS_S3_SECRET_ACCESS_KEY=""
CMS_S3_FORCE_PATH_STYLE="false"

# Password reset email. Required for production recovery; no test-inbox fallback.
# SMTP submission uses port 587 with mandatory STARTTLS.
CMS_SMTP_HOST=""
CMS_SMTP_USER=""
CMS_SMTP_PASSWORD=""
# A verified sender email address (not a display-name string).
CMS_SMTP_FROM=""
CMS_SMTP_FROM_NAME="Elvira"

# First owner only: set temporarily before npm run cms:admin.
# Use a unique password of at least 16 characters; remove it after setup.
CMS_ADMIN_EMAIL=""
CMS_ADMIN_PASSWORD=""
CMS_ADMIN_NAME="Владелец"

# Test runner variables belong in your terminal or a separate .env.test.local.
# It does not automatically load .env/.env.local.
# TEST_BASE_URL="http://127.0.0.1:3100"
# TEST_ADMIN_EMAIL="owner@example.test"
# TEST_ADMIN_PASSWORD=""
